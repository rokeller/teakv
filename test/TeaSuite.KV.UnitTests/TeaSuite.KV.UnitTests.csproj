<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(TestTargetFrameworks)</TargetFrameworks>
    <RootNamespace>TeaSuite.KV</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AutoFixture.Xunit3" Version="4.*" />
    <PackageReference Include="AutoFixture.AutoMoq" Version="4.*" />
    <PackageReference Include="coverlet.MTP" Version="$(CoverletVersionWildcard)" />
    <PackageReference Include="Moq" Version="$(MoqVersionWildcard)" />
    <PackageReference Include="xunit.v3" Version="$(XunitVersionWildcard)" />
  </ItemGroup>

  <ItemGroup Label="netstandard target" Condition="'$(TestTargetsNetStandard)' == 'true'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="$(SystemDependencyVersionWildcard)" />
    <!-- Set the teakv library project referece to target the designated netstandard target -->
    <ProjectReference Include="..\..\src\TeaSuite.KV\TeaSuite.KV.csproj">
      <SetTargetFramework>TargetFramework=$(NetStandardTarget)</SetTargetFramework>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup Label="netX targets" Condition="'$(TestTargetsNetStandard)' != 'true'">
    <ProjectReference Include="..\..\src\TeaSuite.KV\TeaSuite.KV.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="TestData/**/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
